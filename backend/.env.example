# Copy this file to .env  (cp .env.example .env)  — never commit .env to Git.
ENVIRONMENT=development

# Generate your own with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Only used when running outside Docker. Inside Docker, docker-compose.yml sets these
# from the passwords in the top-level .env (created by ./scripts/generate-secrets.sh).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gharkhoji
REDIS_URL=redis://localhost:6379/0

# Your laptop's IP lets the phone app (Expo) call the API later, e.g. http://192.168.1.10:8081
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]

# Phone app needs to reach the API — on Day 3 change to your laptop's Wi-Fi IP, e.g. http://192.168.1.10:8000
PUBLIC_BASE_URL=http://localhost:8000

# Photo storage: "local" for development. On Day 5 switch to "s3" and fill the S3_* values for Cloudflare R2.
STORAGE_BACKEND=local
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BUCKET=gharkhoji-public
# S3_PUBLIC_BASE_URL=https://photos.yourdomain.com

# ---------- SMS (Day 5) ----------
# console = codes are printed in the logs (development). For real SMS choose ONE provider:
SMS_PROVIDER=console
# Sparrow SMS (https://sparrowsms.com): token + the sender identity they approve for you
# SMS_PROVIDER=sparrow
# SPARROW_TOKEN=
# SPARROW_FROM=GharKhoji
# Aakash SMS (https://aakashsms.com): auth token from their dashboard
# SMS_PROVIDER=aakash
# AAKASH_TOKEN=

# ---------- Production only (Day 5 security) ----------
# ENVIRONMENT=production
# ALLOWED_HOSTS=["api.yourdomain.com"]
# CORS_ORIGINS=["https://yourdomain.com"]
# PUBLIC_BASE_URL=https://api.yourdomain.com
